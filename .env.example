# ==============================================================================
# VaccineScheduler Environment Configuration Example
# Copy this file to '.env' and fill in your actual credentials:
#   cp .env.example .env
# ==============================================================================

PORT=3000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here_change_for_production
MONGODB_URI=mongodb+srv://<username>:<password>@your-cluster.mongodb.net/vaccinescheduler?retryWrites=true&w=majority
